{
  "name": "dripp-realestate-erp",
  "version": "1.0.0",
  "description": "Enterprise Real Estate POS & DigiKhata Dual-Sync ERP System",
  "main": "dist-electron/main.js",
  "author": "System Administrator",
  "license": "PROPRIETARY",
  "build": {
    "appId": "com.dripperp.realestate",
    "productName": "Dripp Real Estate ERP",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/@libsql/**"
    ],
    "files": [
      "dist-fresh/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist-release",
      "buildResources": "build"
    }
  },
  "scripts": {
    "dev": "vite",
    "electron:dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:web": "tsc --noEmit && vite build --config vite.config.web.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
