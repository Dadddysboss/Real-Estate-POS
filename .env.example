# Turso Database Configuration (Cloud Sync - Layer 3)
# Get these from https://turso.tech dashboard
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# Vite-prefixed versions for web/browser mode
VITE_TURSO_DATABASE_URL=libsql://your-database-name.turso.io
VITE_TURSO_AUTH_TOKEN=your-auth-token-here

# Local Database Fallback (Development)
# Used when Turso credentials are not provided
# TURSO_DATABASE_URL=file:dripp_erp_local.db

# Application Environment
NODE_ENV=development
VITE_APP_NAME="Dripp Real Estate & DigiKhata ERP"

# GitHub repository for auto-updates (format: owner/repo)
# PUBLISH_GITHUB_OWNER=your-github-username
# PUBLISH_GITHUB_REPO=your-repo-name
