{
  "appId": "com.dripp.realestate.erp",
  "productName": "Dripp Real Estate & DigiKhata ERP",
  "copyright": "Copyright © 2026 Dripp Real Estate Enterprise",
  "directories": {
    "output": "dist-electron",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "extraResources": [
    {
      "from": "src/db",
      "to": "db",
      "filter": ["**/*"]
    }
  ]
}