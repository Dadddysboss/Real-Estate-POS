{
  "appId": "com.dripp.realestate.erp",
  "productName": "Dripp Real Estate & DigiKhata ERP",
  "copyright": "Copyright © 2026 Dripp Real Estate Enterprise",
  "directories": {
    "output": "dist-release",
    "buildResources": "build"
  },
  "files": [
    "dist-fresh/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "win": {
    "icon": "build/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerIcon": "build/icon.png",
    "uninstallerIcon": "build/icon.png"
  }
}