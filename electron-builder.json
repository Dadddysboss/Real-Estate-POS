{
  "appId": "com.dripp.realestate.erp",
  "productName": "Dripp Real Estate & DigiKhata ERP",
  "copyright": "Copyright © 2026 Dripp Real Estate Enterprise",
  "directories": {
    "output": "dist-release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "publish": {
    "provider": "github",
    "owner": "huzaifabutt09",
    "repo": "Real-Estate-POS",
    "releaseType": "release"
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico"
  }
}
